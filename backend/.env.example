# backend/.env.example
# ============================================================
# Copy this file to .env and fill in your real values.
#
# IMPORTANT RULES:
#   1. NEVER commit your real .env file to Git.
#      It is listed in .gitignore so it won't be tracked.
#   2. The .env.example file is safe to commit — it only has
#      placeholder values, no real secrets.
#   3. Every developer/environment needs their own .env file.
# ============================================================

# --- Application ---
APP_NAME=SkillForge AI
APP_VERSION=0.1.0
DEBUG=True

# --- Database (PostgreSQL) ---
# Format: postgresql://username:password@host:port/database_name
# Replace "user", "password", and "skillforge_db" with your actual values.
# If you're running PostgreSQL locally on default port, host is "localhost"
DATABASE_URL=postgresql://user:password@localhost:5432/skillforge_db

# --- Security ---
# This is used to sign JWT tokens. It must be a long random secret string.
# Generate one by running in your terminal:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use the placeholder value below in production!
SECRET_KEY=CHANGE_ME_generate_a_real_secret_key_before_deploying

# JWT settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI / LLM API (Phase 4) ---
# Your LLM API key. Leave empty until you reach Phase 4.
# This key is used server-side only — never expose it to the frontend.
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- CORS Origins ---
# Frontend URLs allowed to call this API.
# Use comma-separated values for multiple origins.
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
