# ============================================================
# .gitignore for SkillForge AI
# This file tells Git what to IGNORE (never track).
# ============================================================

# ----- Python -----
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg

# Python virtual environments
venv/
env/
.venv/
.env_local/

# ----- Environment Variables (VERY IMPORTANT - never commit real secrets) -----
.env
.env.local
.env.production
*.env

# ----- Node.js / React -----
node_modules/
dist/
.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- IDE / Editor -----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ----- Testing -----
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.cover

# ----- Misc -----
*.tmp
*.bak
