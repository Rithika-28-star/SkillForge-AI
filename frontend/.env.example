# frontend/.env.example
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to Git — it's in .gitignore.
# ============================================================
#
# In Vite (React), environment variables MUST start with VITE_
# to be accessible in your JavaScript code.
# Access them like: import.meta.env.VITE_API_BASE_URL
#
# ============================================================

# The URL of your backend FastAPI server
# Change this if your backend runs on a different port or host
VITE_API_BASE_URL=http://localhost:8000

# Application name (used in page titles)
VITE_APP_NAME=SkillForge AI
